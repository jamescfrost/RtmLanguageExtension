{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "RTM",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#data-area"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#field-references"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.rtm",
					"match": "^\\*.*$"
				},
				{
					"name": "comment.block.rtm",
					"match": "<<.*?(>>|$)"
				},
				{
					"name": "comment.block.header.rtm",
					"match": "(?<=^RTM\\b).*?$"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.reserved.rtm",
					"match": "(?<=\\b|_)(?<!\\.)(?<!\\.)(RTM|OVERLAY|PROC|RETURN|ENDPROC|QUITZUG)(?=\\b|_)(?!\\.)"
				},
				{
					"name": "keyword.control.block.rtm",
					"match": "(?<=\\b|_)(?<!\\.)(?<!\\.)(DO|END|CASE|ENDCASE|PROC|ENDPROC|ALWAYS|NEVER|UNTIL|WHILE|REPEAT|EXIT)(?=\\b|_)(?!\\.)"
				},
				{
					"name": "keyword.control.condition.rtm",
					"match": "(?<=\\b|_)(?<!\\.)(?<!\\.)(IF|THEN|ELSE|AND|OR)(?=\\b|_)(?!\\.)"
				},
				{
					"name": "keyword.directive.rtm",
					"match": "^(\\$(ENTRY|NAME|FILES|DATA|EXTDATA|SCRNDATA|USERDATA|EXT|PROG|ABORT|INCLUDESTART|INCLUDEEND|INCLUDE|END))(?=\\b|_)(?!\\.)"
				},
				{
					"name": "keyword.operator.rtm",
					"match": "(_(?=\\s)|\\+\\+|--|\\+_|&|!|%|<:|:>|#|<=|>=|//|/:|\\+|-|\\*|/|=|<|>)"
				},
				{
					"name": "constant.language.rtm",
					"match": "(?:\\b|_\\K)(DOWN|ERASE|CR|BACK|BEEP|CLEAR|LEFT|RIGHT|TABSTOP|UP|FLASH|NOFLASH|HI|LO|KEYED|NOABORT|REV|NOREV|UND|NOUND)(?=\\b|_)(?!\\.)"
				},
				{
					"name": "support.variable.rtm",
					"match": "(?<=\\b|_)(?<!\\.)(@[0-4AB]|[WFHG][0-9]?\\$[a-zA-Z][@a-zA-Z0-9.]*)(?=\\b|_)"
				},
				{
					"match": "^\\s*([A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)*)\\s+(PROC)(?=\\s*\\()",
					"captures": {
						"1": {
							"name": "entity.name.function.rtm"
						},
						"3": {
							"name": "keyword.reserved.rtm"
						}
					}
				},
				{
					"name": "support.function.user.rtm",
					"match": "\\b([A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)*)(?=\\s*\\()"
				},
					{
						"name": "support.function.files.rtm",
						"match": "\\b(ALLOC|COPYR|INDEX|LOCK|NOGROUP|PACK|READ|READLOCK|REF|RELEASE|SEGPTR|TESTLOCK|UNLOCK|WRITE|UNPACK|BNUM|DELETE)(?=\\s*\\()"
					},
				{
					"name": "support.function.data.rtm",
					"match": "\\b(INIT|APPLY)(?=\\s*\\()"
				},
				{
					"name": "support.function.strings.rtm",
					"match": "\\b(CONCAT|CONVERT|EXT|LENGTH|MATCH|TRANSLATE|SUBSTR)(?=\\s*\\()"
				},
				{
					"name": "support.function.arithmetic.rtm",
					"match": "\\b(ABS|EXP2|MAX|MIN|RANDOM|REM)(?=\\s*\\()"
				},
				{
					"name": "support.function.io.rtm",
					"match": "\\b(ALTSCR|DISCARD|ERROR|RC|TRUNC|WAIT|VID|IN|INFLD|INOPT|SETOPT|VALID|OUT|SETERR|FIXERRS|OUTIF|OUTIMM|OUTONLY|DIE)(?=\\s*\\()"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.rtm",
			"begin": "\"",
			"end": "\""
		},
		"data-area": {
			"begin": "(?<=^\\$DATA\\b)",
			"end": "(?=^\\$)",
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"name": "variable.other.field.rtm",
					"match": "^\\s+([A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)*)(?=\\s+[AXNUSFZDC])"
				},
				{
					"name": "support.type.alphanumeric.rtm",
					"match": "(?<=\\s)[AX]\\d+\\b"
				},
				{
					"name": "support.type.numeric.rtm",
					"match": "(?<=\\s)[NUSFZ][BLP\\-]*\\d+(\\.\\d+)?\\b"
				},
				{
					"name": "support.type.date.rtm",
					"match": "(?<=\\s)D[AUEFDMYNHBL]+\\b"
				},
				{
					"name": "support.type.codestring.rtm",
					"begin": "(?<=\\s)(?=C\\^)",
					"end": "\\^{2}",
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"match": "(\\^)(\\w+)(?=\\^)",
							"captures": {
								"2": {
									"name": "constant.numeric.rtm"
								}
							}
						}
					]
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.numeric.rtm",
					"match": "\\b(?<![\\.@])\\d+\\b(?!\\.)"
				}
			]
		},
		"field-references": {
			"patterns": [
				{
					"name": "variable.other.field.rtm",
					"match": "\\b([A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)*)\\b"
				}
			]
		}
	},
	"scopeName": "source.rtm"
}
