{
  "name": "rtm-language-support",
  "displayName": "RTM Language Support",
  "description": "Language support for RTM (Runtime Macro) files with syntax highlighting, IntelliSense, and navigation",
  "version": "0.1.0",
  "publisher": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:rtm"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "languages": [
      {
        "id": "rtm",
        "aliases": [
          "RTM",
          "rtm"
        ],
        "extensions": [
          ".rtm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rtm",
        "scopeName": "source.rtm",
        "path": "./syntaxes/rtm.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.120.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.5"
  }
}
